{
  "name": "pro-gravel-calculator",
  "version": "1.0.0",
  "private": true,
  "description": "Static gravel calculator and material guides",
  "scripts": {
    "dev": "python -m http.server 4173 --bind 127.0.0.1",
    "start": "python -m http.server 4173 --bind 127.0.0.1",
    "build:css": "tailwindcss -i ./src/tailwind-input.css -o ./tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/tailwind-input.css -o ./tailwind.css --watch",
    "test": "node tests/calculator-engine.test.js && node tests/static-qa.test.js"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "tailwindcss": "^3.4.17"
  }
}
